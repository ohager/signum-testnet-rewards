# The SAME database the service publishes to, read with a READ-ONLY token.
#
# Create one with:
#   turso db tokens create <database> --read-only
#
# The public site must never hold the token the publisher writes with: a leaked
# read-only token exposes data that is already public, a leaked write token lets
# anyone rewrite the payout history this page reports.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Seconds before the published snapshot is called stale on the page. Should
# comfortably exceed the service's PUBLISH_INTERVAL_SECONDS heartbeat.
NEXT_PUBLIC_STALENESS_SECONDS=300
