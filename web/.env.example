# The SAME database the service publishes to, read with a READ-ONLY token.
#
# Create one with:
#   turso db tokens create <database> --read-only
#
# The public site must never hold the token the publisher writes with: a leaked
# read-only token exposes data that is already public, a leaked write token lets
# anyone rewrite the payout history this page reports.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Seconds before the published snapshot is called stale on the page.
#
# Measured against the status row's HEARTBEAT, not against block arrivals: the
# service rewrites that row at least every STALENESS_THRESHOLD_SECONDS/3 (60s at
# the service default of 180) whether or not anything changed, precisely so a
# quiet service can be told apart from a dead one. So the natural unit here is
# missed heartbeats, and 240 is four of them.
#
# Deliberately ABOVE the service's own 180s threshold: the operator gets alerted
# at three missed heartbeats, and this public badge appears at four. The person
# who can fix it hears first.
NEXT_PUBLIC_STALENESS_SECONDS=240

# The mainnet account payouts are sent from, as its NUMERIC account id (not the
# S-XXXX-XXXX-XXXX-XXXXX form) — that is what the explorer's /address/ route
# takes.
#
# Set by hand rather than published by the service: the service derives this
# account from PAYOUT_ACCOUNT_SEED, which is the one secret it holds, so nothing
# about that key is written to the read-model. Leave it empty and the page
# simply omits the line; an id that does not match the real payer would be worse
# than none, since its only purpose is letting a visitor audit the payments.
NEXT_PUBLIC_PAYOUT_ACCOUNT_ID=
