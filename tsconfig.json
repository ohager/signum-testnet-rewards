{
  "compilerOptions": {
    // Environment setup & latest features
    // DOM is needed for the admin UI (src/admin/app.tsx, src/ui/components)
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  // The Next.js app under web/ is a separate root with its own tsconfig and its
  // own dependency tree. Without this, `tsc --noEmit` here globs **/* and
  // type-checks it against `types: ["bun"]`, which it is not written for.
  "exclude": ["web", "node_modules"]
}
