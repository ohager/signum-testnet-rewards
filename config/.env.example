# Money settings are declared in SIGNA, not planck. All are REQUIRED with no
# defaults: the service refuses to start rather than pay a guessed amount.
# Agreed parameters: ~900 SIGNA/day at Signum's ~360 blocks/day.
REWARD_PER_BLOCK_SIGNA=2.5
ACCOUNT_DAILY_CAP_SIGNA=100
GLOBAL_DAILY_BUDGET_SIGNA=1000
MIN_PAYOUT_SIGNA=5
MAX_PER_RECIPIENT_PER_BATCH_SIGNA=200
MAX_PER_BATCH_SIGNA=2000
MAX_PER_WALLCLOCK_DAY_SIGNA=3000
MIN_WALLET_BALANCE_SIGNA=5000
MAX_FEE_SIGNA=1

# --- chain ---
TESTNET_NODE_HOST=http://localhost:6876
TESTNET_WS_URL=ws://localhost:6877/events
MAINNET_NODE_HOSTS=CHANGE_ME_NODE_1,CHANGE_ME_NODE_2
# Remote testnet nodes used only to compare chain history. Leave blank to run
# without fork detection. More hosts means a real majority instead of a coin flip.
TESTNET_REFERENCE_NODE_HOSTS=https://europe3.testnet.signum.network
START_HEIGHT=0
BLOCK_OFFSET=2
WALKER_INTERVAL_SECONDS=5

# --- payouts (Phase 2; keep false during shadow mode) ---
PAYOUTS_ENABLED=false
PAYOUT_INTERVAL_MINUTES=360
TX_DEADLINE_MINUTES=30
CONFIRMATIONS_REQUIRED=3
# PAYOUT_ACCOUNT_SEED must NEVER be committed. chmod 600 the real .env.
PAYOUT_ACCOUNT_SEED=

# --- health ---
STALL_THRESHOLD_MINUTES=15
MIN_PEERS=3
SYNC_LAG_BLOCKS=5
ALERT_OPEN_AFTER_CHECKS=3
ALERT_CLOSE_AFTER_CHECKS=3
# Fork detection. Blocks are compared FORK_CHECK_DEPTH behind the lowest height
# any node reports, so propagation skew and short reorgs cannot look like a fork.
# A confirmed fork trips the kill switch, which only a human can clear.
FORK_CHECK_INTERVAL_SECONDS=300
FORK_CHECK_DEPTH=10

# --- publishing: optional. Leave both blank to run without Turso. ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Only rows whose content changed are written, so a quiet interval costs no
# Turso I/O at all. The status row is still refreshed often enough to stay
# within STALENESS_THRESHOLD_SECONDS, and everything is rewritten every
# PUBLISH_FULL_SYNC_MINUTES to repair a remote that was changed behind our back.
PUBLISH_INTERVAL_SECONDS=30
STALENESS_THRESHOLD_SECONDS=180
PUBLISH_FULL_SYNC_MINUTES=60
MAINNET_ACCOUNT_TTL_POSITIVE_SECONDS=86400
MAINNET_ACCOUNT_TTL_NEGATIVE_SECONDS=3600

# --- retention: rolling window for history that is not evidence ---
# Drops health samples, fork observations, resolved alerts and the mainnet
# account cache locally, and published payout rows from Turso.
# NOT dropped: block_rewards (the guard against paying for a block twice, and the
# source of lifetime totals) and batches (each carries the tx id of the on-chain
# payout that is the real record). Both are small; local disk is the cheap
# resource, Turso is not.
RETENTION_DAYS=30

# --- logging ---
# true adds debug output from this service AND from the chain walker, which logs
# every block it processes. Useful while catching up, noisy in production.
VERBOSE_LOGGING=false

# --- storage: must be on the HDD, and the sentinel must exist ---
DATA_DIR=/mnt/hdd/signum-rewards

# --- notifications: each channel activates only if fully configured ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Email needs all three. ALERT_EMAIL_FROM must be a sender on a domain verified
# in your Resend account; there is deliberately no default, because an
# unverified sender is accepted by config and rejected at delivery.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Signum Testnet Rewards <alerts@mail.digital-independence.dev>
# warning = every alert, critical = only the ones worth waking up for.
# Optional; defaults to critical. Telegram and Discord always take everything.
ALERT_EMAIL_MIN_SEVERITY=critical

# --- admin: bind to the LAN interface, NOT 0.0.0.0 ---
ADMIN_BIND_HOST=192.168.1.50
ADMIN_PORT=3100
ADMIN_TOKEN=
